{
  "name": "piku",
  "version": "0.0.31",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/pikucode",
    "directory": "apps/server"
  },
  "bin": {
    "piku": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "record:codex-replay": "bun scripts/record-codex-app-server-replay-fixture.ts",
    "record:claude-replay": "bun scripts/record-claude-agent-sdk-replay-fixture.ts",
    "build:bundle": "vp pack",
    "start": "node dist/bin.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.205",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@pierre/diffs": "catalog:",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@piku/contracts": "workspace:*",
    "@piku/shared": "workspace:*",
    "@piku/web": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
